# scripts/provision.sh installs this to /etc/caddy/Caddyfile
# scripts/deploy.sh --caddy reinstalls it

# Cloudflare Origin CA certificate
(tls) {
	tls /etc/caddy/origin.crt /etc/caddy/origin.key
}

(app) {
	import tls

	encode zstd gzip

	request_body {
		max_size 500MB
	}

	header {
		# stop browsers guessing a content type other than the one we send
		X-Content-Type-Options nosniff
		# full URL as referrer only to ourselves, bare origin cross-site
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Directus
	handle_path /api/* {
		reverse_proxy localhost:8055
	}

	# Heimdall
	handle_path /heimdall/* {
		reverse_proxy localhost:9999
	}

	# socket.io expects this exact path
	handle /socket.io* {
		reverse_proxy localhost:9999
	}
}

beta.reed.kalisz.pl {
	import app

	header {
		X-Robots-Tag "noindex, nofollow"
	}

	handle {
		# basic auth guard
		import /etc/caddy/beta-auth.conf
		reverse_proxy localhost:5000
	}
}

reed.kalisz.pl {
	import app

	handle {
		reverse_proxy localhost:5000
	}
}

www.reed.kalisz.pl {
	import tls

	redir https://reed.kalisz.pl{uri} permanent
}
