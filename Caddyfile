# scripts/provision.sh installs this to /etc/caddy/Caddyfile
# scripts/deploy.sh --caddy reinstalls it

beta.reed.kalisz.pl {
	encode zstd gzip

	request_body {
		max_size 500MB
	}

	header {
		# stop browsers guessing a content type other than the one we send
		X-Content-Type-Options nosniff
		# full URL as referrer only to ourselves, bare origin cross-site
		Referrer-Policy strict-origin-when-cross-origin
		# keep the pre-cutover site out of search results
		X-Robots-Tag "noindex, nofollow"
	}

	# Directus
	handle_path /api/* {
		reverse_proxy localhost:8055
	}

	# Heimdall
	handle_path /heimdall/* {
		reverse_proxy localhost:9999
	}

	# socket.io expects this exact path
	handle /socket.io* {
		reverse_proxy localhost:9999
	}

	# SvelteKit with basic auth guard
	handle {
		import /etc/caddy/beta-auth.conf
		reverse_proxy localhost:5000
	}
}

# VPS hostname
prod.reed.kalisz.pl {
	redir https://beta.reed.kalisz.pl{uri} permanent
}
