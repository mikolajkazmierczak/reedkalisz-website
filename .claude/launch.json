{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reed-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5010",
        "--strictPort"
      ],
      "cwd": "frontend",
      "port": 5010
    },
    {
      "name": "reed-website-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=5011 HOST=127.0.0.1 node build/index.js"
      ],
      "cwd": "frontend",
      "port": 5011
    }
  ]
}
