# HTTP basic auth for beta.reed.kalisz.pl
BETA_AUTH_USER=reed
BETA_AUTH_PASSWORD=

# Local db snapshots frequency.
LOCAL_KEEP_DAILY=14

# External backup frequency.
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

# Backups to Cloudflare R2:
# 1. R2 -> create bucket "reed"
# 2. R2 -> Manage API tokens -> create an Object Read & Write token
# 3. fill this in, then run: ./scripts/backup.sh
# IMPORTANT: Store RESTIC_PASSWORD in a password manager or backups will be unrecoverable!
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/reed
RESTIC_PASSWORD=

# NOT Amazon: R2 speaks the S3 API, and restic reads credentials from AWS_* names
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

